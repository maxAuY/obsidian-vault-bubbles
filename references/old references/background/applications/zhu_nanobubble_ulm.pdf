      <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">IJN-176287-caix-aptamer-functionalized-targeted-nanobubbles-for-ultraso</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Nanobubbles loaded with CAIX aptamer for tumor diagnosis</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
